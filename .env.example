# Frontend values are public browser settings. Keep service-role and SMTP
# credentials in the backend environment only; never put them in frontend/.env.

# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:8000

# Backend only (never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Faculty Email Notifications (Optional: if blank, dev logs to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=true
SMTP_STARTTLS=true
FROM_EMAIL=notifications@ts-sc.local
